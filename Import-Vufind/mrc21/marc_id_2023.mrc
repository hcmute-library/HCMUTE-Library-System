1nam a2200277 a 45000010006000000050011000060200018000170400011000350410008000460820017000540900024000711000031000952450153001262500043002792600052003223000018003745200460003926500019008526500028008716500016008996500032009157000039009477000025009867000024010117000028010356275214/11/2023  a9786045785768  aDHSPKT  aVie  a335.4346223  a335.4346bN573-T926  aNguyễn Thị Thanh Tùng  aNâng cao chất lượng dạy học tác phẩm Hồ Chí Minh/cNguyễn Thị Thanh Tùng, Hoàng Thị Thuận (ch.b.), Nguyễn Thị Xiêm...  aTái bản có sửa chữa, bổ sung  aH.:bChính trị Quốc gia Sự thật,c2023  a399tr.;c21cm  aMột số vấn đề lý luận chung về dạy học tác phẩm Hồ Chí Minh. Giới thiệu một số tác phẩm tiêu biểu của Hồ Chí Minh như: Bản án chế độ thực dân Pháp, Đường kách mệnh, Cương lĩnh chính trị đầu tiên, Tuyên ngôn độc lập, Sửu đổi lối làm việc, Dân vận, Thường thức chính trị, Nâng cao đạo đức cách mạng, quét sạch chủ nghĩa cá nhân, Di chúc.  aHồ Chí Minh  aLãnh tụ cách mạng  aTác phẩm  aTư tưởng Hồ Chí Minh  aHoàng Thị Thuận,eChủ biên  aNguyễn Thị Xiêm  aPhạm Phương Lan  aVũ Thị Huyền Trang01461nam a2200265 a 45000010006000000050011000060200018000170400011000350410008000460820017000540900019000712450294000902500023003842600052004073000018004595000053004775200456005306500033009866500028010196500032010477000039010797000025011187000024011437000028011676275314/11/2023  a9786045775127  aDHSPKT  aVie  a335.4346223  a335.4346bH685  aHọc tập và làm theo tư tưởng, đạo đức, phong cách Hồ Chí Minh về ý chí tự lực, tự cường và khát vọng phát triển đất nước phồn vinh, hạnh phúc:bTài liệu sinh hoạt chi bộ, đoàn thể, cơ quan, đơn vị năm 2021 và toàn khoá  aTái bản lần 2  aH.:bChính trị Quốc gia Sự thật,c2022  a399tr.;c21cm  aĐTTS ghi: Ban Tuyên giáo Trung ương Đảng  aGồm các bài viết của Tổng Bí thư Nguyễn Phú Trọng về một số vấn đề lý luận và thực tiễn việc đẩy mạnh học tập và làm theo tư tưởng, đạo đức, phong cách Hồ Chí Minh; học tập và làm theo tư tưởng, đạo đức, phong cách Hồ Chí Minh về ý chí tự lực, tự cường và khát vọng phát triển đất nước phồn vinh, hạnh phúc trong giai đoạn hiện nay.  aĐạo đức Hồ Chí Minh  aTài liệu học tập  aTư tưởng Hồ Chí Minh  aHoàng Thị Thuận,eChủ biên  aNguyễn Thị Xiêm  aPhạm Phương Lan  aVũ Thị Huyền Trang01009nam a2200253 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900026000731000024000992450024001232500023001472600052001703000018002225200381002406500021006216500025006426500019006676500018006866500028007046500023007326275414/11/2023  a9786045757994  aDHSPKT  aVie  a959.704092223  a959.704092bT772-H678  aTrần Viết Hoàn  cTrần Viết Hoàn  aTái bản lần 5  aH.:bChính trị Quốc gia Sự thật,c2020  a145tr.;c15cm  aGiới thiệu về nơi ở và làm việc của Chủ tịch Hồ Chí Minh tại Phủ Chủ tịch, giàn hoa Phủ Chủ tịch, đường Xoài, nhà 54, nhà Sàn, nhà 67, ao cá, vườn cây, nhân văn Hồ Chí Minh (minh chứng từ nơi ở và làm việc của Người), tình cảm của bạn bè thế giới khi đến với Chủ tịch Hồ Chí Minh.  aChính trị gia  aDi tích lịch sử  aHồ Chí Minh  aKhu dic tích  aLãnh tụ cách mạng  aPhủ Chủ tịch01124nam a2200241 a 45000010006000000050011000060200018000170400011000350410008000460820017000540900019000712450249000902500015003392600052003543000017004065000053004235200308004766500033007846500015008176500019008326500016008516500015008676275514/11/2023  a9786045745267  aDHSPKT  aVie  a335.4346223  a335.4346bX149  aXây dựng ý thức tôn trọng Nhân dân, phát huy dân chủ, chăm lo đời sống Nhân dân theo tư tưởng, đạo đức, phong cách Hồ Chí Minh:bTài liệu sinh hoạt chi bộ, đoàn thể, cơ quan, đơn vị năm 2019  aTái bản  aH.:bChính trị Quốc gia Sự thật,c2019  a87tr.;c15cm  aĐTTS ghi: Ban Tuyên giáo Trung ương Đảng  aTrình bày những nội dung cơ bản về ý thức tôn trọng Nhân dân, phát huy dân chủ, chăm lo đời sống Nhân dân của Chủ tịch Hồ Chí Minh và những nhiệm vụ, giải pháp nhằm học tập, làm theo tư tưởng đó của Người trong giai đoạn hiện nay.  aĐạo đức Hồ Chí Minh  aDân chủ  aHồ Chí Minh  aPhong cách  aViệt Nam00986nam a2200253 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900026000731000022000992450071001212500029001922600052002213000018002735200322002916500021006136500018006346500019006526500028006716500018006996500015007176275614/11/2023  a9786045757970  aDHSPKT  aVie  a959.704092223  a959.704092bT772-G436  aTrần Văn Giàu  aHồ Chí Minh - Vĩ đại một con người/cTrần Văn Giàu  aTái bản lần thứ 7  aH.:bChính trị Quốc gia Sự thật,c2020  a179tr.;c15cm  aGiới thiệu một số bài viết của giáo sư Trần Văn Giàu nghiên cứu về cuộc đời, sự nghiệp, tư tưởng của Chủ tịch Hồ Chí Minh cùng những cống hiến vô cùng to lớn của Người đối với dân tộc Việt Nam và nhân dân tiến bộ trên toàn thế giới.  aChính trị gia  aCuộc đời  aHồ Chí Minh  aLãnh tụ Cách mạng  aSự nghiệp  aViệt Nam00952nam a2200241 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900026000731000022000992450098001212500029002192600052002483000018003005200291003186500021006096500019006306500028006496500018006776500015006956275714/11/2023  a9786045758007  aDHSPKT  aVie  a959.704092223  a959.704092bT772-T562  aTrần Dân Tiên  aNhững mẩu chuyện về đời hoạt động của Hồ Chủ tịch/cTrần Dân Tiên  aTái bản lần thứ 9  aH.:bChính trị Quốc gia Sự thật,c2020  a206tr.;c18cm  aNhững câu chuyện kể lại về một số sự kiện trong cuộc đời hoạt động cách mạng của Hồ Chủ tịch từ lúc Người ra đi tìm đường cứu nước cho đến những năm đầu của cuộc kháng chiến chống thực dân Pháp xâm lược.  aChính trị gia  aHồ Chí Minh  aLãnh tụ Cách mạng  aSự nghiệp  aViệt Nam01187nam a2200241 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900026000731000022000992450070001212500062001912600052002533000018003055200521003236500021008446500019008656500028008846500018009126500015009306275814/11/2023  a9786045787007  aDHSPKT  aVie  a959.704092223  a959.704092bT833-P577  aTrình Quang Phú  aTừ làng Sen đến bến Nhà Rồng:bKý/cTrình Quang Phú  aXuất bản lần thứ 22, có chỉnh sửa, bổ sung  aH.:bChính trị Quốc gia Sự thật,c2023  a360tr.;c21cm  aKể lại những năm tháng đầu gian khó của Chủ tịch Hồ Chí Minh, từ thời niên thiếu đầy gian nan song cũng sớm thể hiện ý chí phi thường của Người, về những ngày Người ở Huế, Phan Thiết, Sài Gòn đến ngày Người rời Bến cảng Nhà Rồng ra đi tìm đường cứu nước. Ghi chép những câu chuyện của những người được gặp gỡ Bác như: Nguyễn Văn Linh, Nguyễn Thị Bình, Trần Văn Trà, Trịnh Đình Thảo...  aChính trị gia  aHồ Chí Minh  aLãnh tụ Cách mạng  aSự nghiệp  aViệt Nam00899nam a2200229 a 45000010006000000050011000060200018000170400011000350410008000460820017000540900025000711000021000962450116001172500061002332600052002943000018003465200223003646500032005876500014006196500014006337000022006476275914/11/2023  a9786045780534  aDHSPKT  aVie  a335.4046223  a335.4346bĐ584-L213  aĐinh Xuân Lâm  aVăn hóa và triết lý phát triển trong tư tưởng Hồ Chí Minh/cĐinh Xuân Lâm, Bùi Đình Phong  aXuất bản lần thứ ba, có sửa chữa, bổ sung  aH.:bChính trị Quốc gia Sự thật,c2022  a531tr.;c21cm  aTập hợp các bài viết nghiên cứu về văn hoá - nền tảng tinh thần, mục tiêu, động lực phát triển của xã hội; văn hoá và triết lý phát triển trong tư tưởng Hồ Chí Minh.  aTư tưởng Hồ Chí Minh  aVăn hóa  aXã hội  aBùi Đình Phong00964nam a2200229 a 45000010006000000050011000060200018000170400011000350410008000460820018000540900025000721000015000972450101001122500062002132600052002753000018003275200301003456500017006466500025006636500032006886500014007206276014/11/2023  a9786045780626  aDHSPKT  aVie  a301.09597223  a301.09597bH678-A596  aHoàng Anh  aXây dựng con người Việt Nam theo di chúc của Chủ tịch Hồ Chí Minh/cHoàng Anh  aXuất bản lần thứ hai, có sửa chữa, bổ sung  aH.:bChính trị Quốc gia Sự thật,c2022  a199tr.;c19cm  aTrình bày tư tưởng Hồ Chí Minh trong Di chúc về vấn đề xây dựng con người Việt Nam. Phân tích và đưa ra những giải pháp nhằm vận dụng tư tưởng đạo đức Hồ Chí Minh vào giáo dục, xây dựng đạo đức con người Việt Nam hiện nay.  aCon người  aSách chuyên khảo  aTư tưởng Hồ Chí Minh  aXã hội01327nam a2200289 a 45000010006000000050011000060200018000170400011000350410008000460820017000540900024000711000030000952450169001252500061002942600052003553000018004075000092004255200359005176500015008766500032008916500017009236500015009407000022009557000020009777000021009977000019010186276114/11/2023  a9786045780831  aDHSPKT  aVie  a335.4346223  a335.4346bT772-T968  aTrần Thị Minh Tuyết  aGiá trị và sự vận dụng, phát triển tư tưởng Hồ Chí Minh trong giai đoạn hiện nay/cTrần Thị Minh Tuyết (ch.b), Doãn Thị Chín, ...  aXuất bản lần thứ hai, có sửa chữa bổ sung  aH.:bChính trị Quốc gia Sự thật,c2022  a360tr.;c21cm  aĐTTS ghi: Học viện Báo chí và Tuyên truyền. Khoa Tư tưởng Hồ Chí Minh  aTrình bày những giá trị lý luận và thực tiễn của tư tưởng Hồ Chí Minh; quá trình Đảng Cộng sản Việt Nam vận dụng và phát triển tư tưởng Hồ Chí Minh trong công cuộc đổi mới đất nước; tiếp tục vận dụng và phát triển sáng tạo tư tưởng Hồ Chí Minh trong tình hình mới.  aGiá trị  aTư tưởng Hồ Chí Minh  aVận dụng  aViệt Nam  aDoãn Thị Chín  aLê Đình Năm  aLê Thị Thảo  aVũ Quang Ánh00483nam a2200193 a 45000010006000000050011000060200018000170400011000350410008000460820012000540900019000661000019000852450036001042500033001402600052001733000018002256500032002436500014002756276214/11/2023  a9786045781685  aDHSPKT  aVie  a306223  a306bH678-M664  aHồ Chí Minh  aVề văn hóa/cHồ Chí Minh  aXuất bản lần thứ hai  aH.:bChính trị Quốc gia Sự thật,c2022  a308tr.;c19cm  aTư tưởng Hồ Chí Minh  aVăn hóa01272nam a2200289 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900021000732450209000942500033003032600052003363000018003885000068004065200304004746500014007786500025007926500032008176500015008497000022008647000025008867000022009117000026009337000023009596276314/11/2023  a9786045780909  aDHSPKT  aVie  a352.609597223  a352.609597bT883  aTư tưởng Hồ Chí Minh về cán bộ, công tác cán bộ và sự kế thừa, vận dụng vào thực tiễn cách mạng Việt Nam/cHoàng Chí Bảo, Trần Anh Tuấn, Trần Văn Phòng...  aXuất bản lần thứ hai  aH.:bChính trị Quốc gia Sự thật,c2022  a451tr.;c21cm  aĐTTS ghi: Bộ Nội vụ. Tạp chí Tổ chức nhà nước  aGồm những bài viết viết của các nhà khoa học, nhà nghiên cứu lý luận phân tích những nội dung cơ bản trong tư tưởng Hồ Chí Minh về cán bộ, công tác cán bộ và sự kế thừa, vận dụng tư tưởng đó vào thực tiễn cách mạng Việt Nam.  aCán bộ  aCông tác cán bộ  aTư tưởng Hồ Chí Minh  aViệt Nam  aHoàng Chí Bảo  aMạch Quang Thắng  aTrần Anh Tuấn  aTrần Minh Trưởng  aTrần Văn Phòng00933nam a2200229 a 45000010006000000050011000060200018000170400011000350410008000460820018000540900024000721000019000962450221001152600052003363000018003885200198004066500021006046500019006256500028006446500016006726500015006886276414/11/2023  a9786045782231  aDHSPKT  aVie  a335. 4346223  a335.4346bH678-M664  aHồ Chí Minh  a5 tác phẩm bảo vật quốc gia:bĐường cách mệnh. Nhật ký trong tù. Lời kêu gọi toàn quốc kháng chiến. Lời kêu gọi đồng bào và chiến sĩ cả nước. Di chúc/cHồ Chí Minh  aH.:bChính trị Quốc gia Sự thật,c2022  a284tr.;c21cm  aGiới thiệu toàn văn 5 tác phẩm của Chủ tịch Hồ Chí Minh được công nhận là bảo vật quốc gia, được tuyển chọn từ bộ sách "Hồ Chí Minh toàn tập".  aChính trị gia  aHồ Chí Minh  aLãnh tụ Cách mạng  aTác phẩm  aViệt Nam01044nam a2200205 a 45000010006000000050011000060200018000170400011000350410008000460820018000540900024000721000019000962450139001152600052002543000018003065200451003246500016007756500032007916500015008236276514/11/2023  a9786045782064  aDHSPKT  aVie  a335. 4346223  a335.4346bH678-M664  aHồ Chí Minh  aXây dựng ý chí tự lực, tự cường và khát vọng phát triển đất nước phồn vinh, hạnh phúc/cHồ Chí Minh  aH.:bChính trị Quốc gia Sự thật,c2022  a188tr.;c15cm  aGồm những đoạn trích từ các bài viết, bài nói, lời kêu gọi nhằm đẩy mạnh công tác tuyên truyền và triển khai thực hiện chuyên đề về học tập và làm theo tư tưởng, đạo đức, phong cách Hồ Chí Minh, được sắp xếp theo các chủ đề: Tư tưởng Hồ Chí Minh về ý chí tự lực, tự cường, về khát vọng phát triển đất nước phồn vinh, hạnh phúc.  aBài viết  aTư tưởng Hồ Chí Minh  aViệt Nam01236nam a2200265 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900021000732450206000942600052003003000026003525200350003785460053007286500019007816500028008006500015008287000028008437000025008717000029008967000023009257000022009486276814/11/2023  a9786045781975  aDHSPKT  aVie  a959.704092223  a959.704092bT588  aTình cảm của nhân dân thế giới với Chủ tịch Hồ Chí Minh = The world people's affection for president Ho Chi Minh/cPhạm Vinh Quang, Phạm Thị Thinh, Phạm Thị Thanh Bình...  aH.:bChính trị Quốc gia Sự thật,c2022  a262tr.:bảnh;c20cm  aTâp hợp những hình ảnh phong phú, khắc hoạ sinh động, sâu sắc chân dung Người Anh hùng giải phóng dân tộc vĩ đại, Nhà văn hoá kiệt xuất Hồ Chí Minh, giúp bạn đọc cảm nhận được tình cảm, sự kính trọng, ngưỡng mộ và tin yêu của bạn bè quốc tế đối với Người.  aChính văn bằng 2 thứ tiếng: Việt - Anh  aHồ Chí Minh  aLãnh tụ cách mạng  aViệt Nam  aĐào Quyền Trưởng  aHoàng Hương Giang  aPhạm Thị Thanh Bình  aPhạm Thị Thinh  aPhạm Vinh Quang00816nam a2200217 a 45000010006000000050011000060200018000170400011000350410008000460820021000540900028000751000019001032450050001222600052001723000018002245200274002426500019005166500032005356500016005676500015005836276914/11/2023  a9786045782910  aDHSPKT  aVie  a305.23509597223  a305.23509597bH678-M664  aHồ Chí Minh  aLời Bác dạy thanh niên/cHồ Chí Minh  aH.:bChính trị Quốc gia Sự thật,c2022  a124tr.;c21cm  aGồm những bức thư, bài viết, bài nói, lời khuyên của Chủ tịch Hồ Chí Minh gửi thanh niên Việt Nam nhằm khích lệ, động viên, phát huy sức mạnh của thế hệ trẻ vào sự nghiệp cách mạng chung của toàn dân tộc.  aHồ Chí Minh  aTư tưởng Hồ Chí Minh  aThanh niên  aViệt Nam00843nam a2200217 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900021000731100044000942450058001382600052001963000018002485200272002666500018005386500019005566500018005756500032005936277014/11/2023  a9786045777343  aDHSPKT  aVie  a959.704092223  a959.704092bH678  aHội Khoa học Lịch sử Việt Nam  aHồ Chí Minh - Người mang lại ánh sáng.nT.1  aH.:bChính trị Quốc gia Sự thật,c2022  a291tr.;c21cm  aGiới thiệu về cuộc đời, sự nghiệp hoạt động cách mạng của Chủ tịch Hồ Chí Minh - Anh hùng giải phóng dân tộc và danh nhân văn hoá thế giới qua những bài viết của các nhà khoa học trong nước và quốc tế.  aCuộc đời  aHồ Chí Minh  aSự nghiệp  aTư tưởng Hồ Chí Minh01292nam a2200229 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900027000731000022001002450098001222600052002203000018002725200653002906500018009436500019009616500032009806500018010126500032010306277314/11/2023  a9786045785423  aDHSPKT  aVie  a959.704092223  a959.704092bĐ631-L755  aĐỗ Hoàng Linh  aHồ Chí Minh - Con người của lịch sử và làm nên lịch sử/cĐỗ Hoàng Linh  aH.:bChính trị Quốc gia Sự thật,c2023  a312tr.;c21cm  aTrình bày hệ thống những diễn biến lịch sử, những sự kiện quan trọng trong quá trình tìm đường cứu nước, giải phóng dân tộc và đấu tranh thống nhất Tổ quốc của Chủ tịch Hồ Chí Minh từ năm 1911 đến năm 1969. Cập nhập những tài liệu mới nhất đã được xác minh về quãng đời hoạt động của Bác; những cống hiến lớn lao của Người đối với Đảng, với Tổ quốc và phong trào cách mạng thế giới, làm nổi bật hình tượng người anh hùng giải phóng dân tộc Việt Nam, chiến sĩ cộng sản lỗi lạc.  aCuộc đời  aHồ Chí Minh  aHoạt động cách mạng  aSự nghiệp  aTư tưởng Hồ Chí Minh00819nam a2200241 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900027000731000024001002450119001242500031002432600052002743000018003265200114003446500018004586500019004766500032004956500018005276500032005456277414/11/2023  a9786045786512  aDHSPKT  aVie  a959.704092223  a959.704092bP534-Đ682  aPhạm Văn Đồng  aHồ Chí Minh - Một con người một dân tộc một thời đại một sự nghiệp/cPhạm Văn Đồng  aXuất bản lần thứ 2  aH.:bChính trị Quốc gia Sự thật,c2023  a100tr.;c19cm  aGiới thiệu cuộc đời và sự nghiệp hoạt động cách mạng của Chủ tịch Hồ Chí Minh.  aCuộc đời  aHồ Chí Minh  aHoạt động cách mạng  aSự nghiệp  aTư tưởng Hồ Chí Minh01092nam a2200241 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900027000731000024001002450084001242500031002082600052002393000018002915200422003096500018007316500019007496500032007686500018008006500032008186277514/11/2023  a9786045786529  aDHSPKT  aVie  a959.704092223  a959.704092bP534-Đ682  aPhạm Văn Đồng  aHồ Chí Minh - Quá khứ, hiện tại và tương lai/cPhạm Văn Đồng  aXuất bản lần thứ 2  aH.:bChính trị Quốc gia Sự thật,c2023  a224tr.;c19cm  aTrình bày những cống hiến trên nhiều lĩnh vực và di sản tư tưởng, đạo đức, phong cách của Chủ tịch Hồ Chí Minh. Phân tích những giá trị quý báu và mang đậm tính thời sự của di sản này đối với sự nghiệp xây dựng chủ nghĩa xã hội ở Việt Nam, cũng như đối với công cuộc cách mạng ở nhiều nước khác trên thế giới.  aCuộc đời  aHồ Chí Minh  aHoạt động cách mạng  aSự nghiệp  aTư tưởng Hồ Chí Minh01205nam a2200229 a 45000010006000000050011000060200018000170400011000350410008000460820018000540900026000721000024000982450116001222500031002382600052002693000018003215200535003396500018008746500019008926500032009116500032009436277714/11/2023  a9786045786550  aDHSPKT  aVie  a301.09597223  a301.09597bP534-Đ682  aPhạm Văn Đồng  aHồ Chí Minh và con người Việt Nam trên con đường dân giàu, nước mạnh/cPhạm Văn Đồng  aXuất bản lần thứ 2  aH.:bChính trị Quốc gia Sự thật,c2023  a164tr.;c19cm  aTái hiện khái quát con người Việt Nam trong lịch sử và sự nghiệp cách mạng của dân tộc dưới sự dẫn dắt của Đảng và Chủ tịch Hồ Chí Minh. Khẳng định nhân dân chính là người làm chủ sự nghiệp dân giàu, nước mạnh, Nhà nước quản lý và Đảng là người lãnh đạo Nhà nước, xã hội thực hiện quyền làm chủ của nhân dân; đồng thời nêu lên những mong mỏi và lòng tin của Người vào tương lai của dân tộc.  aCuộc đời  aHồ Chí Minh  aHoạt động cách mạng  aTư tưởng Hồ Chí Minh01141nam a2200289 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900021000732450140000942500060002342600052002943000018003465200257003646500013006216500019006346500032006536500015006856500032007007000021007327000022007537000032007757000025008077000019008326277814/11/2023  a9786045786574  aDHSPKT  aVie  a959.704092223  a959.704092bN576  aNhững tên gọi bí danh, bút danh của Chủ tịch Hồ Chí Minh/cNguyễn Thị Tình, Chu Đức Tính, Hoàng Thị Nữ...  aXuất bản lần thứ 7, có sửa chữa, bổ sung  aH.:bChính trị Quốc gia Sự thật,c2023  a176tr.;c15cm  aGiới thiệu những tên chính thức của Chủ tịch Hồ Chí Minh, những tên được người khác gọi, những bí danh trong thời kỳ hoạt động bí mật và những bút danh Người viết báo theo thứ tự thời gian.  aBí danh  aHồ Chí Minh  aHoạt động cách mạng  aTên gọi  aTư tưởng Hồ Chí Minh  aChu Đức Tính  aHoàng Thị Nữ  aNguyễn Thị Minh Hương  aNguyễn Thị Tình  aVũ Mạnh Hà01148nam a2200277 a 45000010006000000050011000060200018000170400011000350410008000460820012000540900014000662450145000802500060002252600052002853000018003375000092003555200233004476500018006806500032006986500018007307000033007487000020007817000026008017000023008277000020008506278114/11/2023  a9786045785676  aDHSPKT  aVie  a170223  a170bN576  aNhững mẩu chuyện về tấm gương đạo đức Hồ Chí Minh: Tập 2/cNgô Bá Toại, Nguyễn Đức Bình, Trịnh Duy Kim...  aXuất bản lần thứ 7, có sửa chữa, bổ sung  aH.:bChính trị Quốc gia Sự thật,c2023  a311tr.;c15cm  aĐTTS ghi: Ban Tuyên giáo Trung ương. Trung tâm Thông tin công tác Tuyên giáo  aGồm những câu chuyện viết về Bác Hồ giúp nâng cao nhận thức cho cán bộ đảng viên, công chức, viên chức và nhận thức về giá trị to lớn của tấm gương đạo đức Hồ Chí Minh.  aĐạo đức  aTư tưởng Hồ Chí Minh  aTruyện kể  aLương Thị Bích Hường  aNgô Bá Toại  aNguyễn Đức Bình  aNguyễn Minh Khai  aTrịnh Duy Kim00976nam a2200193 a 45000010006000000050011000060200018000170400011000350410008000460820017000540900024000711000019000952450032001142500031001462600052001773000018002295200503002476500032007506278214/11/2023  a9786045785751  aDHSPKT  aVie  a335.4346223  a335.4346bH678-M664  aHồ Chí Minh  aLời Bác/cHồ Chí Minh  aXuất bản lần thứ 4  aH.:bChính trị Quốc gia Sự thật,c2023  a152tr.;c15cm  aGiới thiệu một số đoạn trích từ các bài viết, bài nói, lời kêu gọi và những tác phẩm của chủ tịch Hồ Chí Minh về các vấn đề như dân tộc và giải phóng dân tộc, chủ nghĩa xã hội và con đường quá độ lên chủ nghĩa xã hội ở Việt Nam, đại đoàn kết dân tộc, kết hợp sức mạnh dân tộc với sức mạnh thời đại, Đảng Cộng sản và nhà nước, văn hoá, đạo đức và con người..  aTư tưởng Hồ Chí Minh01402nam a2200289 a 45000010006000000050011000060200018000170400011000350410008000460820017000540900019000712450196000902500060002862600052003463000018003985200487004166500015009036500021009186500013009396500019009526500028009717000022009997000021010217000025010427000024010677000021010916278314/11/2023  a9786045786505  aDHSPKT  aVie  a335.4346223  a335.4346bD536  aDi chúc của Chủ tịch Hồ Chí Minh - Giá trị lịch sử và ý nghĩa định hướng cho cách mạng Việt Nam/cNguyễn Văn Công, Mạch Quang Thắng, Lý Việt Quang...  aXuất bản lần thứ 2, có sửa chữa, bổ sung  aH.:bChính trị Quốc gia Sự thật,c2023  a132tr.;c21cm  aGiới thiệu nguyên văn và bút tích các bản viết Di chúc của Chủ tịch Hồ Chí Minh; tập hợp một số bài viết về giá trị, ý nghĩa và những giá trị lịch sử của Di chúc: Bác Hồ viết Di chúc - văn kiện lịch sử vô giá, hoàn cảnh ra đời và những điểm cốt lõi trong Di chúc của Chủ tịch Hồ Chí Minh, Di chúc - sự kết tinh triết lý trọng dân, vì dân của Chủ tịch Hồ Chí Minh...  aBút tích  aChính trị gia  aDi chúc  aHồ Chí Minh  aLãnh tụ Cách mạng  aHoàng Chí Bảo  aLý Việt Quang  aMạch Quang Thắng  aNguyễn Văn Công  aVũ Trọng Lâm01078nam a2200205 a 45000010006000000050011000060200018000170400011000350410008000460820016000540900023000701000024000932450057001172500031001742600052002053000017002575200541002746500027008156500030008426278514/11/2023  a9786045758847  aDHSPKT  aVie  a320.512223  a320.512bN573-T367  aNguyễn Chí Thanh  aChống chủ nghĩa cá nhân/cNguyễn Chí Thanh  aXuất bản lần thứ 6  aH.:bChính trị Quốc gia Sự thật,c2020  a92tr.;c19cm  aLàm rõ các vấn đề về chủ nghĩa cá nhân trên quan điểm của chủ nghĩa Mác - Lênin: Nguồn gốc và hoàn cảnh ra đời của chủ nghĩa cá nhân, biểu hiện của chủ nghĩa cá nhân; hình thái phát triển và tác hại do nó gây ra; sự khác nhau giữa chủ nghĩa cá nhân với lợi ích chân chính của cá nhân; ranh giới giữa chủ nghĩa cá nhân và tư tưởng tập thể; phương hướng chống chủ nghĩa cá nhân và xây dựng tư tưởng tập thể...  aChủ nghĩa cá nhân  aTư tưởng chính trị01351nam a2200301 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900026000731000021000992450096001202500031002162600052002473000018002995000042003175200508003596500019008676500028008866500018009146500016009326500015009487000020009637000021009837000025010047000020010296278714/11/2023  a9786045786536  aDHSPKT  aVie  a959.704092223  a959.704092bC559-T588  aChu Đức Tính  aHồ Chí Minh tiểu sử/cChu Đức Tính (ch.b.), Vũ Thị Nhị, Phạm Thị Lai...  aXuất bản lần thứ 5  aH.:bChính trị Quốc gia Sự thật,c2023  a332tr.;c18cm  aĐTTS ghi: Bảo tàng Hồ Chí Minh  aGiới thiệu tiểu sử, sự nghiệp Chủ tịch Hồ Chí Minh từ thời niên thiếu đến giai đoạn ra đi tìm đường cứu nước, thời kì chuẩn bị thành lập Đảng Cộng sản Việt Nam, lãnh đạo phong trào cách mạng, lãnh đạo toàn dân tổng khởi nghĩa, kháng chiến chống thực dân Pháp, và lãnh đạo sự nghiệp xây dựng chủ nghĩa xã hội ở miền Bắc, đấu tranh giải phóng miền Nam, thống nhất đất nước.  aHồ Chí Minh  aLãnh tụ Cách mạng  aSự nghiệp  aTiểu sử  aViệt Nam  aLê Thị Liên  aPhạm Thị Lai  aVăn Thị Thanh Mai  aVũ Thị Nhị00837nam a2200205 a 45000010006000000050011000060200018000170400011000350410008000460820012000540900019000661000028000852450084001132500060001972600052002573000018003095200247003276500025005746500032005996278814/11/2023  a9786045786604  aDHSPKT  aVie  a323223  a323bL185-B613  aLại Thị Thanh Bình  aTư tưởng Hồ Chí Minh về quyền con người/cLại Thị Thanh Bình  aXuất bản lần thứ 2, có sửa chữa, bổ sung  aH.:bChính trị Quốc gia Sự thật,c2023  a288tr.;c21cm  aMột số vấn đề lý luận chung về quyền con người trong tư tưởng Hồ Chí Minh, phân tích nội dung tư tưởng Hồ Chí Minh về con người, giá trị của tư tưởng Hồ Chí Minh về quyền con người.  aQuyền con người  aTư tưởng Hồ Chí Minh00675nam a2200229 a 45000010006000000050011000060200018000170400011000350410008000460820016000540900023000701000019000932450123001122500031002352600052002663000018003186500015003366500026003516500032003776500014004097000022004236278914/11/2023  a9786045785669  aDHSPKT  aVie  a327.172223  a327.172bH678-M664  aHồ Chí Minh  aHồ Chí Minh với những bức thư mong muốn hòa bình cho Việt Nam/cHồ Chí Minh, Nguyễn Anh Minh (st)  aXuất bản lần thứ 2  aH.:bChính trị Quốc gia Sự thật,c2023  a248tr.;c21cm  aHòa bình  aQuan hệ quốc tế  aTư tưởng Hồ Chí Minh  aThư từ  aNguyễn Anh Minh00905nam a2200205 a 45000010006000000050011000060200018000170400011000350410008000460820020000540900027000741000023001012450097001242600052002213000018002735200334002916500018006256500032006436500024006756279014/11/2023  a9786045787168  aDHSPKT  aVie  a324.2597075223  a324.2597075bT772-H719  aTrần Thị Hợi  aXây dựng Đảng về đạo đức theo tư tưởng Hồ Chí Minh/cTrần Thị Hợi  aH.:bChính trị Quốc gia Sự thật,c2023  a304tr.;c21cm  aPhân tích nội dung, giá trị tư tưởng Hồ Chí Minh về xây dựng Đảng về đạo đức; những yếu tố tác động, thành tựu, hạn chế và đề xuất một số phương hướng, giải pháp xây dựng Đảng về đạo đức theo tư tưởng Hồ Chí Minh trong giai đoạn hiện nay.  aĐạo đức  aTư tưởng Hồ Chí Minh  aXây dựng Đảng00935nam a2200229 a 45000010006000000050011000060200018000170400011000350410008000460820019000540900026000731000024000992450100001232500031002232600052002543000018003065200298003246500018006226500019006406500028006596500018006876279214/11/2023  a9786045787625  aDHSPKT  aVie  a959.704092223  a959.704092bN573-N576  aNguyễn Khắc Nho  aHồ Chí Minh - Đỉnh cao truyền thống Nhân Trí Dũng Việt Nam/cNguyễn Khắc Nho  aXuất bản lần thứ 2  aH.:bChính trị Quốc gia Sự thật,c2023  a284tr.;c21cm  aGiới thiệu những bài viết về tư tưởng nhân văn Hồ Chí Minh; trí tuệ ở thời đại Hồ Chí Minh; đạo đức và nhân cách Bác Hồ; tư tưởng ngoại giao hoà bình và nhân nghĩa của Bác; cũng như tấm gương Nhân - Trí - Dũng của Người.  aCuộc đời  aHồ Chí Minh  aLãnh tụ cách mạng  aSự nghiệp00514nam a2200193 a 45000010006000000050011000060200018000170400011000350410008000460820020000540900027000741000019001012450076001202600052001963000018002486500014002666500025002806500015003056281314/11/2023  a9786045785614  aDHSPKT  