    <marc:subfield code="u">http://cds.cern.ch/record/5416/files/PS211.JPG</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="856" ind1="4" ind2=" ">
    <marc:subfield code="u">http://cds.cern.ch/record/5416/files/ps211_1.ps</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="856" ind1="4" ind2=" ">
    <marc:subfield code="u">http://cds.cern.ch/record/5416/files/PS211.gif?subformat=icon</marc:subfield>
