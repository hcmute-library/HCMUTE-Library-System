    <marc:subfield code="p">cerncds:FULLTEXT</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="035" ind1=" " ind2=" ">
    <marc:subfield code="a">AIS.FOUNDATION.EXPERIMENTS.SC87</marc:subfield>
    <marc:subfield code="9">AIS.FOUNDATION.EXPERIMENTS</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="041" ind1=" " ind2=" ">
    <marc:subfield code="a">eng</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="245" ind1=" " ind2=" ">
    <marc:subfield code="a">Study of Target Fragmentation in the Interaction of 86 MeV/A $^{12}$Carbon with Tantalum, Bismuth and Uranium</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="260" ind1=" " ind2=" ">
    <marc:subfield code="c">2002</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="269" ind1=" " ind2=" ">
    <marc:subfield code="c">1980-03-20</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="270" ind1=" " ind2=" ">
    <marc:subfield code="p">Rudstam, G</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="520" ind1=" " ind2=" ">
    <marc:subfield code="a">Using radiochemical techniques we will ; a)~~measure the target fragment mass and charge distributions from the interaction of 86~MeV/A |1|2C with Ta, Bi and U; ; b)~~measure the target fragment forward momentum and average kinetic energy using the thick target-thick catcher technique for the above reactions; and ; c)~~measure the target fragment angular and differential energy distributions using thin target-thin catcher techniques for the reactions with Ta and U. \\ \\ These measurements should allow us to better characterize the transition between low energy and realistic heavy ion reaction mechanisms.</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="595" ind1=" " ind2=" ">
    <marc:subfield code="a">GBOOK200212</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="693" ind1=" " ind2=" ">
