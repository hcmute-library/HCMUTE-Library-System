  <marc:controlfield tag="005">20201119105204.0</marc:controlfield>
  <marc:datafield tag="024" ind1="8" ind2=" ">
    <marc:subfield code="a">oai:cds.cern.ch:5667</marc:subfield>
    <marc:subfield code="q">cerncds:FULLTEXT</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="035" ind1=" " ind2=" ">
    <marc:subfield code="a">AIS.FOUNDATION.EXPERIMENTS.PS210</marc:subfield>
    <marc:subfield code="9">AIS.FOUNDATION.EXPERIMENTS</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="041" ind1=" " ind2=" ">
    <marc:subfield code="a">eng</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="245" ind1=" " ind2=" ">
    <marc:subfield code="a">Antihydrogen Production in $ \bar{p} $ Z - interaction</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="260" ind1=" " ind2=" ">
    <marc:subfield code="c">2002</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="269" ind1=" " ind2=" ">
    <marc:subfield code="c">1995-02-09</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="270" ind1=" " ind2=" ">
    <marc:subfield code="p">Macri, M</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="520" ind1=" " ind2=" ">
    <marc:subfield code="a">% PS210 \\ \\ The production of the antihydrogen atom $ \bar {H}^0 \equiv \bar{p}e $ as the simplest atomic bound state of antimatter has been studied. Nine $ \bar {H}^0 $ have been observed.\\ \\ The production of $ \bar {H}^0 $ is predominantly mediated by the two-photon mechanism in the antiproton-nucleus interaction. In principle $ \bar {H}^0 $ is well suited for investigations of fundamental CPT violation studies under different forces, however, in the present experiment we concentrated on the production of this antimatter object, since so far it never had been observed.</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="595" ind1=" " ind2=" ">
    <marc:subfield code="a">GBOOK200212</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="693" ind1=" " ind2=" ">
    <marc:subfield code="e">PS210</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="693" ind1=" " ind2=" ">
    <marc:subfield code="a">CERN PS</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="856" ind1="4" ind2=" ">
    <marc:subfield code="u">http://ikpe1101.ikp.kfa-juelich.de/ps210/</marc:subfield>
    <marc:subfield code="y">Experiment home page</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="903" ind1=" " ind2=" ">
    <marc:subfield code="s">Finished</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="905" ind1=" " ind2=" ">
    <marc:subfield code="p">Oelert, W</marc:subfield>
  </marc:datafield>
