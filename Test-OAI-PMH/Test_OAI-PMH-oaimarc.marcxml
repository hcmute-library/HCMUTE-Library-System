    <marc:subfield code="q">cerncds:FULLTEXT</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="035" ind1=" " ind2=" ">
    <marc:subfield code="a">AIS.FOUNDATION.EXPERIMENTS.nTOF4</marc:subfield>
    <marc:subfield code="9">AIS.FOUNDATION.EXPERIMENTS</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="041" ind1=" " ind2=" ">
    <marc:subfield code="a">eng</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="245" ind1=" " ind2=" ">
    <marc:subfield code="a">The Re/Os Clock Revisited</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="260" ind1=" " ind2=" ">
    <marc:subfield code="c">2002</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="269" ind1=" " ind2=" ">
    <marc:subfield code="c">2001-04-05</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="270" ind1=" " ind2=" ">
    <marc:subfield code="p">Mengoni, A</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="520" ind1=" " ind2=" ">
    <marc:subfield code="a">The purpose of the proposed project of an accurate measurement of the relevant neutron cross sections of $^{186}$Os and $^{187}$Os is to remove the principal nuclear physics uncertainties in the analysis of the Re/Os cosmochronometer. The necessary cross section information will be obtained in complementary experiments at the nTOF facility at CERN and at the Karlsruhe Van de Graaff accelerator. Transformation of these results into significantly improved stellar reaction rates will allow to evaluate the age of the elements in the framework of galactic chemical evolution models.</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="595" ind1=" " ind2=" ">
    <marc:subfield code="a">GBOOK200212</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="693" ind1=" " ind2=" ">
    <marc:subfield code="e">nTOF4</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="693" ind1=" " ind2=" ">
