  <marc:datafield tag="035" ind1=" " ind2=" ">
    <marc:subfield code="a">AIS.FOUNDATION.EXPERIMENTS.IS300</marc:subfield>
    <marc:subfield code="9">AIS.FOUNDATION.EXPERIMENTS</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="041" ind1=" " ind2=" ">
    <marc:subfield code="a">eng</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="245" ind1=" " ind2=" ">
    <marc:subfield code="a">A search for axions and massive neutrinos</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="260" ind1=" " ind2=" ">
    <marc:subfield code="c">2002</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="269" ind1=" " ind2=" ">
    <marc:subfield code="c">1991-09-18</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="270" ind1=" " ind2=" ">
    <marc:subfield code="p">Ravn, H</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="520" ind1=" " ind2=" ">
    <marc:subfield code="a">This experiment relies on the production of a strong, contamination-free (10$ ^{-12} $) source of radioactive $^{125}$I at the ISOLDE facility. Technical developments to achieve the necessary beam intensity are in progress. \\ \\The possible emission of axions in the 35.5 keV M1 transition of the $^{125}$Te daughter isotope is searched for by the axion analogue of the MÃ¶ssbauer effect, i.e. the axion resonance absorption in a $^{125}$Te resonance absorber. For this purpose all other radiation emitted from the source is shielded by a non-resonant absorber, which is transparent, however, to axions. The resonance absorption is detected by measurement of subsequently emitted X-rays. A sensitivity to the axion emission branching ratio in the nuclear decay of 10$ ^{-7} $ is strived for.</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="961" ind1=" " ind2=" ">
    <marc:subfield code="c">20060708</marc:subfield>
    <marc:subfield code="h">0107</marc:subfield>
    <marc:subfield code="l">IEX01</marc:subfield>
    <marc:subfield code="x">20001107</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="963" ind1=" " ind2=" ">
    <marc:subfield code="a">PUBLIC</marc:subfield>
  </marc:datafield>
</marc:record>
</metadata></record><record><header><identifier>oai:cds.cern.ch:5694</identifier><datestamp>2021-01-15T13:32:10Z</datestamp><setSpec>cerncds:FULLTEXT</setSpec></header><metadata><marc:record xmlns:marc="http://www.loc.gov/MARC21/slim" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.loc.gov/MARC21/slim http://www.loc.gov/standards/marcxml/schema/MARC21slim.xsd" type="Bibliographic">
     <marc:leader>00000coc  2200000uu 4500</marc:leader>
