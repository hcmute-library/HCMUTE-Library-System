  </marc:datafield>
  <marc:datafield tag="961" ind1=" " ind2=" ">
    <marc:subfield code="c">20070223</marc:subfield>
    <marc:subfield code="h">0457</marc:subfield>
    <marc:subfield code="l">IEX01</marc:subfield>
    <marc:subfield code="x">20011203</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="963" ind1=" " ind2=" ">
    <marc:subfield code="a">PUBLIC</marc:subfield>
  </marc:datafield>
