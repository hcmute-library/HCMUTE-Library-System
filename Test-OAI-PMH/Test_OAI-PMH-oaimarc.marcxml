  </marc:datafield>
  <marc:datafield tag="693" ind1=" " ind2=" ">
    <marc:subfield code="a">AD</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="700" ind1=" " ind2=" ">
    <marc:subfield code="a">Zielinski, M</marc:subfield>
    <marc:subfield code="u">003697</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="700" ind1=" " ind2=" ">
