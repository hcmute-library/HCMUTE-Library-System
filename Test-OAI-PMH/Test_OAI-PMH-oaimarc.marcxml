  </marc:datafield>
  <marc:datafield tag="913" ind1=" " ind2=" ">
    <marc:subfield code="p">ISC-P-47.Add.1</marc:subfield>
    <marc:subfield code="u">CERN-ISC-93-11</marc:subfield>
    <marc:subfield code="w">297275</marc:subfield>
