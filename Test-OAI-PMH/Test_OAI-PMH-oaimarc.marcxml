    <marc:subfield code="8">20658</marc:subfield>
    <marc:subfield code="s">61049</marc:subfield>
    <marc:subfield code="u">http://cds.cern.ch/record/5753/files/AD-3.jpg?subformat=icon-640</marc:subfield>
    <marc:subfield code="x">icon-640</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="856" ind1="4" ind2=" ">
    <marc:subfield code="8">20658</marc:subfield>
    <marc:subfield code="s">9287</marc:subfield>
    <marc:subfield code="u">http://cds.cern.ch/record/5753/files/AD-3.jpg?subformat=icon-180</marc:subfield>
