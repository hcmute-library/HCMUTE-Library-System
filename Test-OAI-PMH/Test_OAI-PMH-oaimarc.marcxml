    <marc:subfield code="x">icon</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="856" ind1="4" ind2=" ">
    <marc:subfield code="s">156344</marc:subfield>
    <marc:subfield code="u">http://cds.cern.ch/record/5416/files/PS211.jpg?subformat=icon-640</marc:subfield>
