</metadata></record><record><header><identifier>oai:cds.cern.ch:5608</identifier><datestamp>2019-09-30T06:29:59Z</datestamp><setSpec>cerncds:FULLTEXT</setSpec></header><metadata><marc:record xmlns:marc="http://www.loc.gov/MARC21/slim" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.loc.gov/MARC21/slim http://www.loc.gov/standards/marcxml/schema/MARC21slim.xsd" type="Bibliographic">
     <marc:leader>00000coc  2200000uu 4500</marc:leader>
