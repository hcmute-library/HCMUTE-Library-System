  </marc:datafield>
  <marc:datafield tag="903" ind1=" " ind2=" ">
    <marc:subfield code="s">Finished</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="905" ind1=" " ind2=" ">
    <marc:subfield code="p">Watts, S J</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="905" ind1=" " ind2=" ">
    <marc:subfield code="p">Andersson-lindstroem, G</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="905" ind1=" " ind2=" ">
    <marc:subfield code="p">Lemeilleur, F</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="913" ind1=" " ind2=" ">
    <marc:subfield code="p">LHCC-P-62</marc:subfield>
    <marc:subfield code="u">CERN-LHCC-96-23</marc:subfield>
    <marc:subfield code="w">333971</marc:subfield>
  </marc:datafield>
