    <marc:subfield code="a">Constans, N P</marc:subfield>
    <marc:subfield code="u">000387</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="700" ind1=" " ind2=" ">
    <marc:subfield code="a">Gulkanyan, H</marc:subfield>
    <marc:subfield code="u">000780</marc:subfield>
    <marc:subfield code="0">AUTHOR|(CDS)2078109</marc:subfield>
    <marc:subfield code="9">#BEARD#</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="700" ind1=" " ind2=" ">
    <marc:subfield code="a">Kluberg, L</marc:subfield>
    <marc:subfield code="u">000380</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="710" ind1=" " ind2=" ">
    <marc:subfield code="g">DIMUONS</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="856" ind1="4" ind2=" ">
    <marc:subfield code="u">http://na50.web.cern.ch/NA50/</marc:subfield>
    <marc:subfield code="y">Experiment home page</marc:subfield>
  </marc:datafield>
