  <marc:datafield tag="024" ind1="8" ind2=" ">
    <marc:subfield code="a">oai:cds.cern.ch:5742</marc:subfield>
    <marc:subfield code="p">cerncds:FULLTEXT</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="035" ind1=" " ind2=" ">
    <marc:subfield code="a">AIS.FOUNDATION.EXPERIMENTS.PS212</marc:subfield>
    <marc:subfield code="9">AIS.FOUNDATION.EXPERIMENTS</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="041" ind1=" " ind2=" ">
    <marc:subfield code="a">eng</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="245" ind1=" " ind2=" ">
    <marc:subfield code="a">Lifetime Measurements of $ \pi ^+ \pi ^- $ and $\pi^{+-} K^{-+}$ Atoms to Test Low-Energy QCD Predictions</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="260" ind1=" " ind2=" ">
    <marc:subfield code="c">2002</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="269" ind1=" " ind2=" ">
    <marc:subfield code="c">1996-02-08</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="270" ind1=" " ind2=" ">
    <marc:subfield code="p">Drijard, D</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="270" ind1=" " ind2=" ">
    <marc:subfield code="p">Lanaro, A</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="270" ind1=" " ind2=" ">
    <marc:subfield code="p">Tauscher, L</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="520" ind1=" " ind2=" ">
    <marc:subfield code="a">%PS212 \\ \\ The proposed experiment aims to measure the lifetime of $ \pi ^+ \pi ^- $ atoms in the ground state with 10\% precision, using the 24~GeV/c proton beam of the CERN Proton Synchrotron. As the value of the above lifetime of order 10$ ^- ^{1} ^{5} $s is dictated by a strong interaction at low energy, the precise measurement of this quantity enables to determine a combination of S-wave pion scattering lengths to 5\%. Pion scattering lengths have been calculated in the framework of chiral perturbation theory and values predicted at the same level of accuracy have, up to now, never been confronted with accurate experimental data. Such a measurement would submit the understanding of chiral symmetry breaking of QCD to a crucial test.</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="595" ind1=" " ind2=" ">
    <marc:subfield code="a">GBOOK200212</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="693" ind1=" " ind2=" ">
    <marc:subfield code="e">PS212</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="693" ind1=" " ind2=" ">
    <marc:subfield code="a">CERN PS</marc:subfield>
  </marc:datafield>
