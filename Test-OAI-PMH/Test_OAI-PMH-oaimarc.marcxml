  <marc:datafield tag="913" ind1=" " ind2=" ">
    <marc:subfield code="p">ISC-P-46</marc:subfield>
    <marc:subfield code="u">CERN-ISC-93-7</marc:subfield>
    <marc:subfield code="w">297265</marc:subfield>
  </marc:datafield>
  <marc:datafield tag="913" ind1=" " ind2=" ">
    <marc:subfield code="p">ISC-P-47</marc:subfield>
    <marc:subfield code="u">CERN-ISC-93-10</marc:subfield>
